<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ürün Yönetimi | <%= firma_adi %> Yönetim</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-layout">
        <%- include('partials/sidebar', { activePage: 'urunler' }) %>

        <div class="admin-main">
            <%- include('partials/topbar', { pageTitle: 'Ürün Yönetimi', pageIcon: 'fas fa-mobile-screen', badgeCount: products.length }) %>

            <!-- #2 Toast -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="toast toast-success"><i class="fas fa-check-circle"></i> <%= success %></div>
            <% } %>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap: wrap; gap: 10px;">
                <div style="display:flex; gap:10px;">
                    <button class="btn btn-add" onclick="openModal('addModal')" style="margin:0;"><i class="fas fa-plus"></i> Yeni Ürün Ekle</button>
                    <button class="btn" style="background:var(--card-bg); color:var(--text-main); border:1px solid var(--border-color); font-weight:600; cursor:pointer; padding:10px 16px; border-radius:8px;" onclick="exportToCSV()"><i class="fas fa-download"></i> CSV İndir</button>
                </div>
                <form class="admin-search" style="margin:0;" method="GET" action="/admin/urunler">
                    <input type="text" id="tableSearch" name="search" placeholder="Ürün veya marka ara..." value="<%= (filters && filters.search) ? filters.search : '' %>">
                    <select name="sort" style="padding:10px; border:1.5px solid #e2e8f0; border-radius:8px; font-family:inherit;">
                        <option value="newest" <%= (filters && filters.sort === 'newest') ? 'selected' : '' %>>En Yeni</option>
                        <option value="oldest" <%= (filters && filters.sort === 'oldest') ? 'selected' : '' %>>En Eski</option>
                        <option value="name_asc" <%= (filters && filters.sort === 'name_asc') ? 'selected' : '' %>>İsim (A-Z)</option>
                        <option value="name_desc" <%= (filters && filters.sort === 'name_desc') ? 'selected' : '' %>>İsim (Z-A)</option>
                        <option value="price_asc" <%= (filters && filters.sort === 'price_asc') ? 'selected' : '' %>>Fiyat (Artan)</option>
                        <option value="price_desc" <%= (filters && filters.sort === 'price_desc') ? 'selected' : '' %>>Fiyat (Azalan)</option>
                        <option value="featured" <%= (filters && filters.sort === 'featured') ? 'selected' : '' %>>Öne Çıkan Üstte</option>
                    </select>
                    <button class="btn btn-add" type="submit" style="margin:0;"><i class="fas fa-filter"></i> Uygula</button>
                </form>
            </div>

            <% if (products.length === 0) { %>
                <!-- #4 Empty State -->
                <div class="empty-state">
                    <i class="fas fa-box-open"></i>
                    <h3>Henüz ürün eklenmemiş</h3>
                    <p>İlk ürününüzü eklemek için yukarıdaki butonu kullanın.</p>
                </div>
            <% } else { %>
            <div class="table-wrap">
                <table id="productsDataTable">
                    <thead>
                        <tr>
                            <th style="width:40px;"><input type="checkbox" id="selectAll" onclick="toggleAllCheckboxes(this)"></th>
                            <th>ID</th>
                            <th>Görsel</th>
                            <th>Öne Çıkan</th>
                            <th>Ürün Adı</th>
                            <th>Marka</th>
                            <th>Fiyat</th>
                            <th>Stok</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="productTable">
                        <% products.map((p,idx) => { %>
                            <tr>
                                <td><input type="checkbox" class="rowCheckbox" value="<%= p.id %>"></td>
                                <td><%= p.id %></td>
                                <td><img src="<%= p.image_url %>" alt="<%= p.name %>" style="width:40px; height:40px; object-fit:contain; border-radius:6px;"></td>
                                <td style="text-align:center;">
                                    <form action="/admin/urunler/<%= p.id %>/one-cikar" method="POST" style="display:inline;">
                                        <button class="btn" type="submit" title="Öne çıkar / kaldır" aria-label="Öne çıkar veya kaldır" style="background:transparent; border:none; padding:0; min-width:auto;">
                                            <% if(p.is_featured) { %>
                                                <i class="fas fa-star" style="color:#f59e0b;" title="Öne Çıkan"></i>
                                            <% } else { %>
                                                <i class="far fa-star" style="color:var(--border-color);" title="Normal"></i>
                                            <% } %>
                                        </button>
                                    </form>
                                </td>
                                <td style="font-weight:600;"><%= p.name %></td>
                                <td><%= p.brand %></td>
                                <td><%= p.price %> TL</td>
                                <td><span class="badge-status <%= p.stock_status === 'Stokta' ? 'badge-approved' : (p.stock_status === 'Azalıyor' ? 'badge-pending' : 'badge-out') %>"><%= p.stock_status %></span></td>
                                <td>
                                    <button class="btn btn-edit" onclick="openEditModal('<%= p.id %>', '<%= p.name %>', '<%= p.brand %>', '<%= p.price %>', '<%= p.stock_status %>', '<%= p.image_url %>', <%= !!p.is_featured %>)"><i class="fas fa-edit"></i></button>
                                    <form action="/admin/urunler/<%= p.id %>/sil" method="POST" style="display:inline;" data-confirm data-confirm-title="Ürün silinsin mi?" data-confirm-message="Bu ürünü silerseniz geri almak zor olabilir. Devam etmek istiyor musunuz?" data-confirm-approve="Evet, sil">
                                    <button class="btn btn-delete" aria-label="Ürünü sil"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div style="margin-top:12px; display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
                <div style="font-size:13px; color:var(--text-gray);">
                    Toplam <strong><%= pagination ? pagination.total : products.length %></strong> kayıt
                </div>
                <% if (pagination && pagination.totalPages > 1) { %>
                    <div style="display:flex; gap:8px;">
                        <% if (pagination.page > 1) { %>
                            <a class="btn" href="/admin/urunler?page=<%= pagination.page - 1 %>&search=<%= encodeURIComponent(filters && filters.search ? filters.search : '') %>&sort=<%= encodeURIComponent(filters && filters.sort ? filters.sort : 'newest') %>">Önceki</a>
                        <% } %>
                        <span style="align-self:center; font-size:13px; color:var(--text-gray);"><%= pagination.page %> / <%= pagination.totalPages %></span>
                        <% if (pagination.page < pagination.totalPages) { %>
                            <a class="btn" href="/admin/urunler?page=<%= pagination.page + 1 %>&search=<%= encodeURIComponent(filters && filters.search ? filters.search : '') %>&sort=<%= encodeURIComponent(filters && filters.sort ? filters.sort : 'newest') %>">Sonraki</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
            <% } %>

            <!-- Ekleme Modalı -->
            <div id="addModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2><i class="fas fa-plus-circle" style="color:var(--primary); margin-right:8px;"></i> Yeni Ürün Ekle</h2>
                        <button class="close-btn" onclick="closeModal('addModal')">&times;</button>
                    </div>
                    <form action="/admin/urunler/ekle" method="POST">
                        <div class="form-group">
                            <label>Ürün Adı</label>
                            <input type="text" name="name" placeholder="Örn: iPhone 15 Pro Max" required>
                        </div>
                        <div class="form-group">
                            <label>Marka <span style="font-size:12px; color:var(--text-gray);">(Seç veya Yaz)</span></label>
                            <input list="brandDict" name="brand" placeholder="Marka Seç / Yaz" autocomplete="off" required>
                            <datalist id="brandDict">
                                <% uniqueBrands.forEach(b => { %>
                                    <option value="<%= b %>">
                                <% }) %>
                            </datalist>
                        </div>
                        <div class="form-group">
                            <label>Fiyat (TL)</label>
                            <input type="number" name="price" step="0.01" min="0" placeholder="Örn: 74999" required>
                        </div>
                        <div class="form-group">
                            <label>Stok Durumu</label>
                            <select name="stock_status">
                                <option value="Stokta">Stokta</option>
                                <option value="Azalıyor">Azalıyor</option>
                                <option value="Tükendi">Tükendi</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Görsel URL</label>
                            <input type="text" name="image_url" value="/images/telefon.webp">
                        </div>
                        <div class="form-group" style="display:flex; align-items:center; gap:10px;">
                            <input type="checkbox" name="is_featured" id="add_is_featured" style="width:auto; transform:scale(1.2);">
                            <label for="add_is_featured" style="margin:0; cursor:pointer;">Anasayfada "Öne Çıkan Cihaz" olarak göster</label>
                        </div>
                        <button type="submit" class="btn btn-add" style="width:100%; justify-content:center; padding:12px;">Kaydet</button>
                    </form>
                </div>
            </div>

            <!-- Düzenleme Modalı -->
            <div id="editModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2><i class="fas fa-edit" style="color:#f59e0b; margin-right:8px;"></i> Ürün Düzenle</h2>
                        <button class="close-btn" onclick="closeModal('editModal')">&times;</button>
                    </div>
                    <form id="editForm" method="POST">
                        <div class="form-group">
                            <label>Ürün Adı</label>
                            <input type="text" name="name" id="edit_name" required>
                        </div>
                        <div class="form-group">
                            <label>Marka <span style="font-size:12px; color:var(--text-gray);">(Seç veya Yaz)</span></label>
                            <input list="brandDict" name="brand" id="edit_brand" autocomplete="off" required>
                        </div>
                        <div class="form-group" id="new_brand_edit" style="display:none;">
                            <label>Yeni Marka Adı</label>
                            <input type="text" name="new_brand" placeholder="Örn: SONY">
                        </div>
                        <div class="form-group">
                            <label>Fiyat</label>
                            <input type="text" name="price" id="edit_price" required>
                        </div>
                        <div class="form-group">
                            <label>Stok Durumu</label>
                            <select name="stock_status" id="edit_stock_status">
                                <option value="Stokta">Stokta</option>
                                <option value="Azalıyor">Azalıyor</option>
                                <option value="Tükendi">Tükendi</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Görsel URL</label>
                            <input type="text" name="image_url" id="edit_image_url">
                        </div>
                        <div class="form-group" style="display:flex; align-items:center; gap:10px;">
                            <input type="checkbox" name="is_featured" id="edit_is_featured" style="width:auto; transform:scale(1.2);">
                            <label for="edit_is_featured" style="margin:0; cursor:pointer;">Anasayfada "Öne Çıkan Cihaz" olarak göster</label>
                        </div>
                        <button type="submit" class="btn btn-edit" style="width:100%; justify-content:center; padding:12px;">Güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        function openEditModal(id, name, brand, price, stock, image, isFeatured) {
            document.getElementById('editForm').action = '/admin/urunler/' + id + '/duzenle';
            document.getElementById('edit_name').value = name;
            document.getElementById('edit_brand').value = brand;
            document.getElementById('edit_price').value = price;
            document.getElementById('edit_stock_status').value = stock;
            document.getElementById('edit_image_url').value = image;
            document.getElementById('edit_is_featured').checked = isFeatured === true || isFeatured === 'true';
            openModal('editModal');
        }

        // #5 Client-side table search
        function filterTable(query) {
            const rows = document.querySelectorAll('#productTable tr');
            const q = query.toLowerCase();
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(q) ? '' : 'none';
            });
        }

        // CSV Export Data
        function exportToCSV() {
            const table = document.getElementById('productsDataTable');
            let csv = [];
            // Sadece görünen satırları ve başlıkları alalım
            const rows = table.querySelectorAll('tr');
            const escapeCell = (v) => {
                const s = String(v ?? '')
                    .replace(/(\r\n|\n|\r)/gm, ' ')
                    .trim()
                    .replace(/"/g, '""');
                return `"${s}"`;
            };
            
            for (let i = 0; i < rows.length; i++) {
                let row = [], cols = rows[i].querySelectorAll('td, th');
                // İlk sütun checkbox, son sütun işlemler. Bunları atlayalım. (index 1 to length-2)
                for (let j = 1; j < cols.length - 1; j++) {
                    if (i === 0) {
                        const headerText = (cols[j].textContent || '').trim().toLowerCase();
                        if (headerText === 'görsel') continue;
                    } else {
                        // Görsel sütunu (td index: 2) CSV'ye girmez
                        if (j === 2) continue;
                    }
                    // Sadece metni al, görselleri/butonları yoksay
                    let cell = cols[j];
                    let text = '';
                    // Öne Çıkan sütunu CSV'de + olarak yazılsın
                    if (i !== 0 && j === 3) {
                        text = cell.querySelector('.fas.fa-star') ? '+' : '';
                    } else {
                        text = (cell.textContent || '');
                    }
                    text = text.replace(/\s*TL$/i, '').trim();
                    row.push(escapeCell(text));
                }
                if(row.length > 0) csv.push(row.join(';'));
            }

            const csvFile = new Blob(["\uFEFF"+csv.join('\r\n')], {type: "text/csv;charset=utf-8;"});
            const downloadLink = document.createElement("a");
            downloadLink.download = "urunler_raporu.csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }

        // Toplu Seçim (Bulk Select)
        function toggleAllCheckboxes(source) {
            const checkboxes = document.querySelectorAll('.rowCheckbox');
            checkboxes.forEach(cb => {
                cb.checked = source.checked;
            });
        }

        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) event.target.style.display = 'none';
        }
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeModal('addModal');
                closeModal('editModal');
            }
        });
    </script>
</body>
</html>
