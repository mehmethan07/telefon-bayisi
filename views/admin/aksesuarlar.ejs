<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aksesuar Yönetimi | <%= firma_adi %> Yönetim</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-layout">
        <%- include('partials/sidebar', { activePage: 'aksesuarlar' }) %>

        <div class="admin-main">
            <%- include('partials/topbar', { pageTitle: 'Aksesuar Yönetimi', pageIcon: 'fas fa-headphones', badgeCount: aksesuarlar.length }) %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="toast toast-success"><i class="fas fa-check-circle"></i> <%= success %></div>
            <% } %>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:10px;">
                <div style="display:flex; gap:10px;">
                    <button class="btn btn-add" onclick="openModal('addModal')" style="margin:0;"><i class="fas fa-plus"></i> Yeni Aksesuar Ekle</button>
                    <button class="btn" style="background:var(--card-bg); color:var(--text-main); border:1px solid var(--border-color); font-weight:600; cursor:pointer; padding:10px 16px; border-radius:8px;" onclick="exportToCSV()"><i class="fas fa-download"></i> CSV İndir</button>
                </div>
                <form class="admin-search" style="margin:0;" method="GET" action="/admin/aksesuarlar">
                    <input type="text" id="tableSearch" name="search" placeholder="Aksesuar, kategori veya marka ara..." value="<%= (filters && filters.search) ? filters.search : '' %>">
                    <select name="sort" style="padding:10px; border:1.5px solid #e2e8f0; border-radius:8px; font-family:inherit;">
                        <option value="newest" <%= (filters && filters.sort === 'newest') ? 'selected' : '' %>>En Yeni</option>
                        <option value="oldest" <%= (filters && filters.sort === 'oldest') ? 'selected' : '' %>>En Eski</option>
                        <option value="name_asc" <%= (filters && filters.sort === 'name_asc') ? 'selected' : '' %>>İsim (A-Z)</option>
                        <option value="name_desc" <%= (filters && filters.sort === 'name_desc') ? 'selected' : '' %>>İsim (Z-A)</option>
                        <option value="price_asc" <%= (filters && filters.sort === 'price_asc') ? 'selected' : '' %>>Fiyat (Artan)</option>
                        <option value="price_desc" <%= (filters && filters.sort === 'price_desc') ? 'selected' : '' %>>Fiyat (Azalan)</option>
                        <option value="featured" <%= (filters && filters.sort === 'featured') ? 'selected' : '' %>>Öne Çıkan Üstte</option>
                    </select>
                    <button class="btn btn-add" type="submit" style="margin:0;"><i class="fas fa-filter"></i> Uygula</button>
                </form>
            </div>

            <% if (aksesuarlar.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-headphones"></i>
                    <h3>Henüz aksesuar eklenmemiş</h3>
                    <p>İlk aksesuarınızı eklemek için yukarıdaki butonu kullanın.</p>
                </div>
            <% } else { %>
            <div class="table-wrap">
                <table id="aksesuarDataTable">
                    <thead>
                        <tr>
                            <th style="width:40px;"><input type="checkbox" id="selectAll" onclick="toggleAllCheckboxes(this)"></th>
                            <th>ID</th>
                            <th>İkon</th>
                            <th>Öne Çıkan</th>
                            <th>Aksesuar Adı</th>
                            <th>Kategori</th>
                            <th>Fiyat</th>
                            <th>Stok</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="aksTable">
                        <% aksesuarlar.map((a,idx) => { %>
                            <tr>
                                <td><input type="checkbox" class="rowCheckbox" value="<%= a.id %>"></td>
                                <td><%= a.id %></td>
                                <td><i class="<%= a.icon %>" style="font-size:22px; color:var(--primary);"></i></td>
                                <td style="text-align:center;">
                                    <form action="/admin/aksesuarlar/<%= a.id %>/one-cikar" method="POST" style="display:inline;">
                                        <button class="btn" type="submit" title="Öne çıkar / kaldır" aria-label="Öne çıkar veya kaldır" style="background:transparent; border:none; padding:0; min-width:auto;">
                                            <% if(a.is_featured) { %>
                                                <i class="fas fa-star" style="color:#f59e0b;" title="Öne Çıkan"></i>
                                            <% } else { %>
                                                <i class="far fa-star" style="color:var(--border-color);" title="Normal"></i>
                                            <% } %>
                                        </button>
                                    </form>
                                </td>
                                <td style="font-weight:600;"><%= a.name %></td>
                                <td><%= a.category %></td>
                                <td><%= a.price %> TL</td>
                                <td><span class="badge-status <%= a.stock_status === 'Stokta' ? 'badge-approved' : (a.stock_status === 'Azalıyor' ? 'badge-pending' : 'badge-out') %>"><%= a.stock_status %></span></td>
                                <td>
                                    <button
                                        class="btn btn-edit"
                                        data-id="<%= a.id %>"
                                        data-name="<%= encodeURIComponent(a.name) %>"
                                        data-category="<%= encodeURIComponent(a.category) %>"
                                        data-price="<%= a.price %>"
                                        data-stock="<%= encodeURIComponent(a.stock_status) %>"
                                        data-icon="<%= encodeURIComponent(a.icon) %>"
                                        data-featured="<%= !!a.is_featured %>"
                                        onclick="openEditModalFromBtn(this)"
                                    ><i class="fas fa-edit"></i></button>
                                    <form action="/admin/aksesuarlar/<%= a.id %>/sil" method="POST" style="display:inline;" data-confirm data-confirm-title="Aksesuar silinsin mi?" data-confirm-message="Bu aksesuarı silerseniz geri almak zor olabilir. Devam etmek istiyor musunuz?" data-confirm-approve="Evet, sil">
                                    <button class="btn btn-delete" aria-label="Aksesuarı sil"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div style="margin-top:12px; display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
                <div style="font-size:13px; color:var(--text-gray);">
                    Toplam <strong><%= pagination ? pagination.total : aksesuarlar.length %></strong> kayıt
                </div>
                <% if (pagination && pagination.totalPages > 1) { %>
                    <div style="display:flex; gap:8px;">
                        <% if (pagination.page > 1) { %>
                            <a class="btn" href="/admin/aksesuarlar?page=<%= pagination.page - 1 %>&search=<%= encodeURIComponent(filters && filters.search ? filters.search : '') %>&sort=<%= encodeURIComponent(filters && filters.sort ? filters.sort : 'newest') %>">Önceki</a>
                        <% } %>
                        <span style="align-self:center; font-size:13px; color:var(--text-gray);"><%= pagination.page %> / <%= pagination.totalPages %></span>
                        <% if (pagination.page < pagination.totalPages) { %>
                            <a class="btn" href="/admin/aksesuarlar?page=<%= pagination.page + 1 %>&search=<%= encodeURIComponent(filters && filters.search ? filters.search : '') %>&sort=<%= encodeURIComponent(filters && filters.sort ? filters.sort : 'newest') %>">Sonraki</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
            <% } %>

            <!-- Ekleme Modalı -->
            <div id="addModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2><i class="fas fa-plus-circle" style="color:var(--primary); margin-right:8px;"></i> Yeni Aksesuar Ekle</h2>
                        <button class="close-btn" onclick="closeModal('addModal')">&times;</button>
                    </div>
                    <form action="/admin/aksesuarlar/ekle" method="POST">
                        <div class="form-group">
                            <label>Aksesuar Adı</label>
                            <input type="text" name="name" placeholder="Örn: iPhone 15 Pro Kılıf" required>
                        </div>
                        <div class="form-group">
                            <label>Kategori <span style="font-size:12px; color:var(--text-gray);">(Seç veya Yaz)</span></label>
                            <input list="catDict" name="category" placeholder="Kategori Seç / Yaz" autocomplete="off" required>
                            <datalist id="catDict">
                                <% uniqueCategories.forEach(c => { %>
                                    <option value="<%= c.name %>">
                                <% }) %>
                            </datalist>
                        </div>
                        <div class="form-group">
                            <label>Fiyat (TL)</label>
                            <input type="number" name="price" step="0.01" min="0" placeholder="Örn: 500" required>
                        </div>
                        <div class="form-group">
                            <label>Stok Durumu</label>
                            <select name="stock_status">
                                <option value="Stokta">Stokta</option>
                                <option value="Azalıyor">Azalıyor</option>
                                <option value="Tükendi">Tükendi</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>İkon Seçimi</label>
                            <select id="add_icon_select" onchange="handleIconSelection('add')">
                                <option value="fas fa-plug" selected>Şarj / Kablo</option>
                                <option value="fas fa-headphones">Kulaklık</option>
                                <option value="fas fa-bolt">Güç / Adaptör</option>
                                <option value="fas fa-shield-halved">Koruma / Kılıf</option>
                                <option value="fas fa-mobile-screen">Telefon</option>
                                <option value="fas fa-battery-full">Batarya / Powerbank</option>
                                <option value="fas fa-car">Araç İçi</option>
                                <option value="other">Diğer (özel ikon sınıfı)</option>
                            </select>
                            <input type="text" name="icon_custom" id="add_icon_custom" placeholder="Örn: fas fa-plug" style="display:none; margin-top:8px;">
                            <input type="hidden" name="icon" id="add_icon_hidden" value="fas fa-plug">
                            <div style="margin-top:8px; font-size:13px; color:var(--text-gray); display:flex; align-items:center; gap:8px;">
                                <span>Önizleme:</span>
                                <i id="add_icon_preview" class="fas fa-plug" style="font-size:18px; color:var(--primary);"></i>
                            </div>
                        </div>
                        <div class="form-group" style="display:flex; align-items:center; gap:10px;">
                            <input type="checkbox" name="is_featured" id="add_is_featured" style="width:auto; transform:scale(1.2);">
                            <label for="add_is_featured" style="margin:0; cursor:pointer;">Anasayfada "Öne Çıkan Aksesuar" olarak göster</label>
                        </div>
                        <button type="submit" class="btn btn-add" style="width:100%; justify-content:center; padding:12px;">Kaydet</button>
                    </form>
                </div>
            </div>

            <!-- Düzenleme Modalı -->
            <div id="editModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2><i class="fas fa-edit" style="color:#f59e0b; margin-right:8px;"></i> Aksesuar Düzenle</h2>
                        <button class="close-btn" onclick="closeModal('editModal')">&times;</button>
                    </div>
                    <form id="editForm" method="POST">
                        <div class="form-group">
                            <label>Aksesuar Adı</label>
                            <input type="text" name="name" id="edit_name" required>
                        </div>
                        <div class="form-group">
                            <label>Kategori <span style="font-size:12px; color:var(--text-gray);">(Seç veya Yaz)</span></label>
                            <input list="catDict" name="category" id="edit_category" autocomplete="off" required>
                        </div>
                        <div class="form-group">
                            <label>Fiyat</label>
                            <input type="text" name="price" id="edit_price" required>
                        </div>
                        <div class="form-group">
                            <label>Stok Durumu</label>
                            <select name="stock_status" id="edit_stock_status">
                                <option value="Stokta">Stokta</option>
                                <option value="Azalıyor">Azalıyor</option>
                                <option value="Tükendi">Tükendi</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>İkon Seçimi</label>
                            <select id="edit_icon_select" onchange="handleIconSelection('edit')">
                                <option value="fas fa-plug">Şarj / Kablo</option>
                                <option value="fas fa-headphones">Kulaklık</option>
                                <option value="fas fa-bolt">Güç / Adaptör</option>
                                <option value="fas fa-shield-halved">Koruma / Kılıf</option>
                                <option value="fas fa-mobile-screen">Telefon</option>
                                <option value="fas fa-battery-full">Batarya / Powerbank</option>
                                <option value="fas fa-car">Araç İçi</option>
                                <option value="other">Diğer (özel ikon sınıfı)</option>
                            </select>
                            <input type="text" id="edit_icon_custom" placeholder="Örn: fas fa-plug" style="display:none; margin-top:8px;">
                            <input type="hidden" name="icon" id="edit_icon_hidden">
                            <div style="margin-top:8px; font-size:13px; color:var(--text-gray); display:flex; align-items:center; gap:8px;">
                                <span>Önizleme:</span>
                                <i id="edit_icon_preview" class="fas fa-plug" style="font-size:18px; color:var(--primary);"></i>
                            </div>
                        </div>
                        <div class="form-group" style="display:flex; align-items:center; gap:10px;">
                            <input type="checkbox" name="is_featured" id="edit_is_featured" style="width:auto; transform:scale(1.2);">
                            <label for="edit_is_featured" style="margin:0; cursor:pointer;">Anasayfada "Öne Çıkan Aksesuar" olarak göster</label>
                        </div>
                        <button type="submit" class="btn btn-edit" style="width:100%; justify-content:center; padding:12px;">Güncelle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        function openEditModal(id, name, cat, price, stockStatus, icon, isFeatured) {
            document.getElementById('editForm').action = '/admin/aksesuarlar/' + id + '/duzenle';
            document.getElementById('edit_name').value = name;
            document.getElementById('edit_category').value = cat;
            document.getElementById('edit_price').value = price;
            document.getElementById('edit_stock_status').value = stockStatus || 'Stokta';
            const knownIcons = [
                'fas fa-plug', 'fas fa-headphones', 'fas fa-bolt', 'fas fa-shield-halved',
                'fas fa-mobile-screen', 'fas fa-battery-full', 'fas fa-car'
            ];
            const editSelect = document.getElementById('edit_icon_select');
            const editCustom = document.getElementById('edit_icon_custom');
            if (knownIcons.includes(icon)) {
                editSelect.value = icon;
                editCustom.value = '';
            } else {
                editSelect.value = 'other';
                editCustom.value = icon || '';
            }
            handleIconSelection('edit');
            document.getElementById('edit_is_featured').checked = isFeatured === true || isFeatured === 'true';
            openModal('editModal');
        }

        function openEditModalFromBtn(btn) {
            const read = (k) => decodeURIComponent(btn.getAttribute(`data-${k}`) || '');
            openEditModal(
                btn.getAttribute('data-id'),
                read('name'),
                read('category'),
                btn.getAttribute('data-price'),
                read('stock'),
                read('icon'),
                btn.getAttribute('data-featured') === 'true'
            );
        }

        function handleIconSelection(prefix) {
            const selectEl = document.getElementById(prefix + '_icon_select');
            const customEl = document.getElementById(prefix + '_icon_custom');
            const hiddenEl = document.getElementById(prefix + '_icon_hidden');
            const previewEl = document.getElementById(prefix + '_icon_preview');

            if (!selectEl || !customEl || !hiddenEl || !previewEl) return;

            const useCustom = selectEl.value === 'other';
            customEl.style.display = useCustom ? 'block' : 'none';

            const finalIcon = useCustom ? (customEl.value.trim() || 'fas fa-plug') : selectEl.value;
            hiddenEl.value = finalIcon;
            previewEl.className = finalIcon;
        }

        document.addEventListener('DOMContentLoaded', function() {
            const addCustom = document.getElementById('add_icon_custom');
            const editCustom = document.getElementById('edit_icon_custom');
            if (addCustom) addCustom.addEventListener('input', () => handleIconSelection('add'));
            if (editCustom) editCustom.addEventListener('input', () => handleIconSelection('edit'));
            handleIconSelection('add');
            handleIconSelection('edit');
        });

        // CSV Dışa Aktar
        function exportToCSV() {
            const table = document.getElementById('aksesuarDataTable');
            let csv = [];
            const rows = table.querySelectorAll('tr');
            const escapeCell = (v) => {
                const s = String(v ?? '')
                    .replace(/(\r\n|\n|\r)/gm, ' ')
                    .trim()
                    .replace(/"/g, '""');
                return `"${s}"`;
            };
            
            for (let i = 0; i < rows.length; i++) {
                let row = [], cols = rows[i].querySelectorAll('td, th');
                for (let j = 1; j < cols.length - 1; j++) {
                    // İkon sütunu (index: 2) CSV'ye girmez (header + data)
                    if (j === 2) continue;
                    let cell = cols[j];
                    let text = '';
                    // Öne Çıkan sütunu CSV'de + olarak yazılsın
                    if (i !== 0 && j === 3) {
                        text = cell.querySelector('.fas.fa-star') ? '+' : '';
                    } else {
                        text = (cell.textContent || '');
                    }
                    text = text.replace(/\s*TL$/i, '').trim();
                    row.push(escapeCell(text));
                }
                if(row.length > 0) csv.push(row.join(';'));
            }

            const csvFile = new Blob(["\uFEFF"+csv.join('\r\n')], {type: "text/csv;charset=utf-8;"});
            const downloadLink = document.createElement("a");
            downloadLink.download = "aksesuarlar_raporu.csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }

        // Toplu seçim
        function toggleAllCheckboxes(source) {
            const checkboxes = document.querySelectorAll('.rowCheckbox');
            checkboxes.forEach(cb => { cb.checked = source.checked; });
        }

        window.onclick = function(event) { if (event.target.classList.contains('modal')) event.target.style.display = 'none'; }
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeModal('addModal');
                closeModal('editModal');
            }
        });
    </script>
</body>
</html>
