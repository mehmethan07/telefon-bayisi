</main> <footer class="main-footer" style="background-color: #f8fafc; padding-top: 60px; margin-top: 60px; border-top: 1px solid var(--border-color);">
    <div class="footer-grid">
        <!-- Brand & Social -->
        <div class="footer-col-brand">
            <h3 style="font-family:'Space Grotesk',sans-serif; font-size:1.5rem; margin-bottom:15px; color:var(--text-main);"><%= firma_adi %><span style="color:var(--primary-accent);">.</span></h3>
            <p style="font-size:14px; color:var(--text-gray); line-height:1.6; margin-bottom: 25px;">En yeni akıllı telefonlar, orijinal aksesuarlar ve profesyonel cihaz onarım hizmetleri ile yanınızdayız.</p>
            <div class="footer-socials" style="display: flex; gap: 12px;">
                <% if (settings && settings.instagramActive && settings.instagram !== '#') { %>
                <a href="<%= settings.instagram %>" class="social-icon instagram" title="Instagram" target="_blank"><i class="fab fa-instagram"></i></a>
                <% } %>
                <% if (settings && settings.facebookActive && settings.facebook !== '#') { %>
                <a href="<%= settings.facebook %>" class="social-icon facebook" title="Facebook" target="_blank"><i class="fab fa-facebook-f"></i></a>
                <% } %>
                <% if (settings && settings.twitterActive && settings.twitter !== '#') { %>
                <a href="<%= settings.twitter %>" class="social-icon twitter" title="Twitter/X" target="_blank"><i class="fab fa-x-twitter"></i></a>
                <% } %>
                <% if (settings && settings.youtubeActive && settings.youtube !== '#') { %>
                <a href="<%= settings.youtube %>" class="social-icon youtube" title="YouTube" target="_blank"><i class="fab fa-youtube"></i></a>
                <% } %>
            </div>
        </div>

        <!-- Hızlı Linkler -->
        <div class="footer-col-links">
            <h4 style="font-size:15px; font-weight:700; margin-bottom:20px; color:var(--text-main);">Hızlı Linkler</h4>
            <div class="footer-links" style="display:flex; flex-direction:column; gap:12px; font-size:14px;">
                <a href="/urunler">Tüm Cihazlar</a>
                <a href="/aksesuarlar">Aksesuarlar</a>
                <a href="/servis">Teknik Servis</a>
            </div>
        </div>

        <!-- Destek -->
        <div class="footer-col-links">
            <h4 style="font-size:15px; font-weight:700; margin-bottom:20px; color:var(--text-main);">Kurumsal</h4>
            <div class="footer-links" style="display:flex; flex-direction:column; gap:12px; font-size:14px;">
                <a href="/hakkimizda">Hakkımızda</a>
                <a href="/iletisim">İletişim</a>
                <a href="/siparis/sorgula">Durum Sorgula</a>
            </div>
        </div>

        <!-- Contact Info -->
        <div class="footer-col-contact">
            <h4 style="font-size:15px; font-weight:700; margin-bottom:20px; color:var(--text-main);">İletişim Bilgileri</h4>
            <div class="contact-details" style="display:flex; flex-direction:column; gap:15px; font-size:14px; color: var(--text-gray);">
                <div class="contact-item" style="display: flex; gap: 10px; align-items: flex-start;">
                    <i class="fas fa-location-dot" style="color: var(--primary-accent); margin-top: 4px;"></i>
                    <span>Örnek Mah. Teknoloji Cad. No:42<br>İstanbul, Türkiye</span>
                </div>
                <div class="contact-item" style="display: flex; gap: 10px; align-items: center;">
                    <i class="fas fa-phone" style="color: var(--primary-accent);"></i>
                    <span>+90 <%= settings && settings.whatsapp ? settings.whatsapp.replace(/(\d{3})(\d{3})(\d{2})(\d{2})/, "$1 $2 $3 $4") : "555 123 45 67" %></span>
                </div>
                <div class="contact-item" style="display: flex; gap: 10px; align-items: center;">
                    <i class="fas fa-envelope" style="color: var(--primary-accent);"></i>
                    <span>info@bayim.com</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div style="background-color: white; border-top: 1px solid var(--border-color); padding: 25px 5%;">
        <div class="footer-bottom-bar" style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
            <div style="font-size:13px; color:var(--text-gray);">
                &copy; 2026 <strong><%= firma_adi %></strong>. Tüm hakları saklıdır.
            </div>
            <div class="payment-icons" style="display: flex; gap: 10px; color: #cbd5e1; font-size: 24px;">
                <i class="fab fa-cc-visa"></i>
                <i class="fab fa-cc-mastercard"></i>
                <i class="fab fa-cc-amex"></i>
            </div>
        </div>
    </div>
</footer>

<style>
    /* Footer Layout Classes */
    .footer-grid {
        max-width: 1200px; 
        margin: 0 auto; 
        padding: 0 5%; 
        display: grid; 
        grid-template-columns: 2fr 1fr 1fr 1.5fr; 
        gap: 40px; 
        align-items: start; 
        margin-bottom: 40px;
    }

    /* Footer Social Icons */
    .social-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: white;
        color: var(--text-gray);
        font-size: 16px;
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
        text-decoration: none;
    }
    
    .social-icon:hover {
        transform: translateY(-4px);
        color: white;
        border-color: transparent;
    }
    
    .social-icon.instagram:hover { background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); box-shadow: 0 6px 12px rgba(225, 48, 108, 0.3); }
    .social-icon.facebook:hover { background-color: #1877f2; box-shadow: 0 6px 12px rgba(24, 119, 242, 0.3); }
    .social-icon.twitter:hover { background-color: #000000; box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2); }
    .social-icon.youtube:hover { background-color: #ff0000; box-shadow: 0 6px 12px rgba(255, 0, 0, 0.3); }

    /* Footer Links */
    .footer-links a {
        color: var(--text-gray);
        text-decoration: none;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
    }
    .footer-links a:before {
        content: '\f105'; /* FontAwesome angle-right */
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        margin-right: 8px;
        font-size: 12px;
        color: var(--primary-accent);
        opacity: 0;
        transform: translateX(-5px);
        transition: all 0.2s ease;
    }
    .footer-links a:hover {
        color: var(--primary-accent);
        padding-left: 5px;
    }
    .footer-links a:hover:before {
        opacity: 1;
        transform: translateX(0);
    }

    /* Mobile Responsive */
    @media (max-width: 992px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (max-width: 768px) {
        .footer-grid {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 30px;
        }
        .footer-socials {
            justify-content: center;
        }
        .footer-links {
            align-items: center;
        }
        .contact-item {
            justify-content: center;
            text-align: center;
            flex-direction: column;
            gap: 5px !important;
        }
        .contact-item i {
            margin: 0 auto;
            font-size: 18px;
        }
        .footer-bottom-bar {
            flex-direction: column;
            justify-content: center;
            text-align: center;
        }
    }
</style>

    <!-- Scroll to Top Button -->
    <div id="scrollToTop" style="position:fixed; bottom:100px; right:25px; width:45px; height:45px; background:var(--text-main); color:white; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px; cursor:pointer; opacity:0; visibility:hidden; transition:0.3s; z-index:998; box-shadow:0 4px 10px rgba(0,0,0,0.2);"
         title="Yukarı Çık">
        <i class="fas fa-chevron-up"></i>
    </div>

    <!-- WhatsApp Floating Button -->
    <% if (settings && settings.whatsappActive) { %>
    <a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener"
       style="position:fixed; bottom:25px; right:25px; width:60px; height:60px; background:#25D366; color:white; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:28px; box-shadow:0 4px 15px rgba(37,211,102,0.35); z-index:999; transition:transform 0.3s; text-decoration:none;"
       onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'"
       title="WhatsApp'tan Yazın">
        <i class="fab fa-whatsapp"></i>
    </a>
    <% } %>

    <div id="globalConfirmModal" style="position:fixed; inset:0; background:rgba(2,6,23,0.45); display:none; align-items:center; justify-content:center; z-index:2000; padding:16px;">
        <div style="width:100%; max-width:460px; background:#fff; border-radius:14px; border:1px solid #e2e8f0; box-shadow:0 24px 60px rgba(2,6,23,0.2);">
            <div style="padding:20px 20px 12px 20px; border-bottom:1px solid #e2e8f0;">
                <h3 id="globalConfirmTitle" style="margin:0; font-size:1.05rem; color:#0f172a;">Emin misiniz?</h3>
            </div>
            <div style="padding:14px 20px 20px 20px;">
                <p id="globalConfirmMessage" style="margin:0; color:#475569; line-height:1.6;">Bu işlemi gerçekleştirmek istediğinizi onaylayın.</p>
                <div style="margin-top:18px; display:flex; justify-content:flex-end; gap:10px;">
                    <button type="button" id="globalConfirmCancel" style="padding:10px 14px; border-radius:8px; border:1px solid #cbd5e1; background:#fff; color:#334155; font-weight:600; cursor:pointer;">Vazgeç</button>
                    <button type="button" id="globalConfirmApprove" style="padding:10px 14px; border-radius:8px; border:1px solid #0284c7; background:#0ea5e9; color:#fff; font-weight:700; cursor:pointer;">Onayla</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
    <script>
        // Scroll to Top Logic
        const btnScrollTop = document.getElementById("scrollToTop");
        window.addEventListener("scroll", () => {
            if (window.scrollY > 300) {
                btnScrollTop.style.opacity = "1";
                btnScrollTop.style.visibility = "visible";
            } else {
                btnScrollTop.style.opacity = "0";
                btnScrollTop.style.visibility = "hidden";
            }
        });
        btnScrollTop.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        // Skeleton Loading Simulation
        document.addEventListener("DOMContentLoaded", () => {
            // Apply skeleton class to main elements temporarily for the aesthetic effect
            const cards = document.querySelectorAll('.product-card, .service-card, .acc-card');
            cards.forEach(card => card.classList.add('skeleton'));
            
            setTimeout(() => {
                cards.forEach(card => card.classList.remove('skeleton'));
            }, 600); // 600ms fake loading for visual feedback
        });

        function showCustomConfirm(options = {}) {
            const modal = document.getElementById('globalConfirmModal');
            const titleEl = document.getElementById('globalConfirmTitle');
            const messageEl = document.getElementById('globalConfirmMessage');
            const okBtn = document.getElementById('globalConfirmApprove');
            const cancelBtn = document.getElementById('globalConfirmCancel');

            titleEl.textContent = options.title || 'Emin misiniz?';
            messageEl.textContent = options.message || 'Bu işlemi gerçekleştirmek istediğinizi onaylayın.';
            okBtn.textContent = options.confirmText || 'Onayla';
            cancelBtn.textContent = options.cancelText || 'Vazgeç';

            modal.style.display = 'flex';

            return new Promise(resolve => {
                const cleanup = () => {
                    modal.style.display = 'none';
                    okBtn.removeEventListener('click', onOk);
                    cancelBtn.removeEventListener('click', onCancel);
                    modal.removeEventListener('click', onBackdrop);
                };
                const onOk = () => { cleanup(); resolve(true); };
                const onCancel = () => { cleanup(); resolve(false); };
                const onBackdrop = (e) => {
                    if (e.target === modal) {
                        cleanup();
                        resolve(false);
                    }
                };

                okBtn.addEventListener('click', onOk);
                cancelBtn.addEventListener('click', onCancel);
                modal.addEventListener('click', onBackdrop);
            });
        }

        window.showCustomConfirm = showCustomConfirm;

        document.addEventListener('submit', async (e) => {
            const form = e.target.closest('form[data-confirm]');
            if (!form || form.dataset.confirmHandled === 'true') return;

            e.preventDefault();
            const ok = await showCustomConfirm({
                title: form.dataset.confirmTitle || 'Emin misiniz?',
                message: form.dataset.confirmMessage || 'Bu işlemi gerçekleştirmek istediğinizi onaylayın.',
                confirmText: form.dataset.confirmApprove || 'Onayla',
                cancelText: form.dataset.confirmCancel || 'Vazgeç'
            });
            if (!ok) return;

            form.dataset.confirmHandled = 'true';
            form.requestSubmit();
            form.dataset.confirmHandled = 'false';
        });

        document.addEventListener('click', async (e) => {
            const link = e.target.closest('a[data-confirm]');
            if (!link || link.dataset.confirmHandled === 'true') return;

            e.preventDefault();
            const ok = await showCustomConfirm({
                title: link.dataset.confirmTitle || 'Emin misiniz?',
                message: link.dataset.confirmMessage || 'Bu işlemi gerçekleştirmek istediğinizi onaylayın.',
                confirmText: link.dataset.confirmApprove || 'Onayla',
                cancelText: link.dataset.confirmCancel || 'Vazgeç'
            });
            if (!ok) return;

            link.dataset.confirmHandled = 'true';
            window.location.href = link.href;
        });

        // Sepete Ekle AJAX Interceptor
        document.addEventListener('submit', async (e) => {
            const form = e.target;
            if (form.getAttribute('action') === '/sepet/ekle') {
                e.preventDefault();
                
                const btn = form.querySelector('button[type="submit"]');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                btn.disabled = true;

                try {
                    const formData = new URLSearchParams(new FormData(form));
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/x-www-form-urlencoded'
                        }
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        // Update cart badge
                        let badge = document.getElementById('cartBadge');
                        if (!badge) {
                            const cartBtn = document.getElementById('headerCartBtn');
                            if(cartBtn) cartBtn.innerHTML += `<span class="cart-badge" id="cartBadge">${data.cartCount}</span>`;
                            badge = document.getElementById('cartBadge');
                        } else {
                            badge.textContent = data.cartCount;
                        }
                        
                        // Bounce animation
                        if(badge) {
                            badge.style.transform = 'scale(1.5)';
                            setTimeout(() => badge.style.transform = 'scale(1)', 300);
                        }

                        // Show Toast
                        showToast('<i class="fas fa-check-circle" style="font-size:18px;"></i> Ürün sepete eklendi!', 'success');
                    } else {
                        showToast('<i class="fas fa-exclamation-circle" style="font-size:18px;"></i> ' + (data.message || 'Hata oluştu.'), 'error');
                    }
                } catch (error) {
                    showToast('<i class="fas fa-exclamation-circle" style="font-size:18px;"></i> Bir hata oluştu.', 'error');
                } finally {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            }
        });

        function showToast(html, type) {
            let toastBox = document.getElementById('globalToastBox');
            if (!toastBox) {
                toastBox = document.createElement('div');
                toastBox.id = 'globalToastBox';
                toastBox.style.cssText = 'position:fixed; top:80px; right:20px; z-index:9999; display:flex; flex-direction:column; gap:10px; pointer-events:none;';
                document.body.appendChild(toastBox);
            }
            
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? '#10b981' : '#ef4444';
            toast.style.cssText = `background:${bgColor}; color:white; padding:14px 20px; border-radius:10px; box-shadow:0 10px 25px rgba(0,0,0,0.15); font-weight:600; display:flex; align-items:center; gap:12px; transform:translateX(120%); transition:0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); font-family:'Inter', sans-serif; font-size:14px;`;
            toast.innerHTML = html;
            
            toastBox.appendChild(toast);
            
            requestAnimationFrame(() => {
                toast.style.transform = 'translateX(0)';
            });
            
            setTimeout(() => {
                toast.style.transform = 'translateX(120%)';
                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }
    </script>
</body>
</html>