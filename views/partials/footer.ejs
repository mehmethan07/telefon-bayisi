                    <i class="fas fa-location-dot"></i>
                    <span><%- settings && settings.address ? settings.address.replace(/\n/g, '<br>') : "Örnek Mah. Teknoloji Cad. No:42<br>İstanbul, Türkiye" %></span>
                </div>
                <div class="contact-item">
                    <i class="fas fa-phone"></i>
                    <span>+<%= settings && settings.whatsapp ? settings.whatsapp.replace(/(\d{2})(\d{3})(\d{3})(\d{4})/, "$1 $2 $3 $4") : "90 555 123 4567" %></span>
                </div>
                <div class="contact-item">
                    <i class="fas fa-envelope"></i>
