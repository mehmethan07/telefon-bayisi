                <% } %>
                <% if (settings && settings.twitterActive && settings.twitter !== '#') { %>
                <a href="<%= settings.twitter %>" class="social-icon twitter" title="Twitter/X" target="_blank"><i class="fab fa-x-twitter"></i></a>
                <% } %>
                <% if (settings && settings.youtubeActive && settings.youtube !== '#') { %>
                <a href="<%= settings.youtube %>" class="social-icon youtube" title="YouTube" target="_blank"><i class="fab fa-youtube"></i></a>
                <% } %>
