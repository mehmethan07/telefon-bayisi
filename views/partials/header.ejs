<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= firma_adi %></title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/hero.css">
    <link rel="stylesheet" href="/css/sections.css">
    <link rel="stylesheet" href="/css/products.css">
    <link rel="stylesheet" href="/css/servis.css">
    <link rel="stylesheet" href="/css/error.css">
    <link rel="stylesheet" href="/css/hakkimizda.css">
    <link rel="stylesheet" href="/css/aksesuarlar.css">
    <link rel="stylesheet" href="/css/detay.css">
    <link rel="stylesheet" href="/css/servis-kayit.css">
    <link rel="stylesheet" href="/css/iletisim.css">
    <link rel="stylesheet" href="/css/footer.css">
</head>
<body>

    <!-- Mobile Overlay (Point 6) -->
    <div class="mobile-menu-overlay"></div>

    <header class="main-header">
        <a href="/" class="logo"><%= firma_adi %></a>
        
        <nav class="main-nav">
            <!-- Dropdown: Cihazlar -->
            <div class="nav-dropdown">
                <a href="/urunler" class="nav-link <%= currentPath.startsWith('/urunler') ? 'active' : '' %>">Cihazlar <i class="fas fa-chevron-down" style="font-size:10px; margin-left:3px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/urunler">Tüm Cihazlar</a>
                    <a href="/urunler?search=apple">Apple</a>
                    <a href="/urunler?search=samsung">Samsung</a>
                    <a href="/urunler?search=xiaomi">Xiaomi</a>
                </div>
            </div>

            <!-- Dropdown: Aksesuarlar -->
            <div class="nav-dropdown">
                <a href="/aksesuarlar" class="nav-link <%= currentPath.startsWith('/aksesuarlar') ? 'active' : '' %>">Aksesuarlar <i class="fas fa-chevron-down" style="font-size:10px; margin-left:3px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/aksesuarlar">Tüm Aksesuarlar</a>
                    <a href="/aksesuarlar?search=kılıf">Kılıf & Koruma</a>
                    <a href="/aksesuarlar?search=şarj">Şarj & Kablo</a>
                    <a href="/aksesuarlar?search=kulaklık">Ses & Kulaklık</a>
                </div>
            </div>

            <a href="/servis" class="nav-link <%= currentPath.startsWith('/servis') ? 'active' : '' %>">Servis</a>
            <a href="/siparis/sorgula" class="nav-link <%= currentPath.startsWith('/siparis/sorgula') ? 'active' : '' %>">Sipariş Takip</a>
            <a href="/iletisim" class="nav-contact-btn <%= currentPath === '/iletisim' ? 'active' : '' %>">İletişim</a>
        </nav>

        <!-- Right Actions Grouping (Point 1) -->
        <div class="header-right-actions">
            <a href="/sepet" class="cart-btn" id="headerCartBtn">
                <i class="fas fa-shopping-cart"></i>
                <% if (sepet_sayisi > 0) { %>
                    <span class="cart-badge" id="cartBadge"><%= sepet_sayisi %></span>
                <% } %>
            </a>
            <a href="/iletisim" class="header-btn">İletişim</a>
            <button class="menu-toggle" id="menuToggleBtn">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </header>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const header = document.querySelector('.main-header');
            const menuToggle = document.getElementById('menuToggleBtn');
            const mainNav = document.querySelector('.main-nav');
            const overlay = document.querySelector('.mobile-menu-overlay');

            // Scroll Effect (Point 5)
            window.addEventListener('scroll', () => {
                if (window.scrollY > 20) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });

            // Mobile Menu Toggle & Click Outside (Point 6)
            function toggleMenu() {
                mainNav.classList.toggle('open');
                overlay.classList.toggle('active');
                
                const icon = menuToggle.querySelector('i');
                if (mainNav.classList.contains('open')) {
                    icon.classList.remove('fa-bars');
                    icon.classList.add('fa-times');
                } else {
                    icon.classList.remove('fa-times');
                    icon.classList.add('fa-bars');
                }
            }

            menuToggle.addEventListener('click', toggleMenu);
            overlay.addEventListener('click', toggleMenu);

            // Cart Badge Animation (Point 7)
            window.animateCartBadge = function() {
                const badge = document.getElementById('cartBadge');
                if (badge) {
                    badge.classList.remove('bounce-anim');
                    void badge.offsetWidth; // trigger reflow
                    badge.classList.add('bounce-anim');
                }
            };

            // Sayfa yenilenmesiyle sepete eklenen ürünler için animasyon tetikleyici
            const currentCartSize = <%= sepet_sayisi %>;
            const prevCartSize = sessionStorage.getItem('bayim_cart_size');
            if (prevCartSize !== null && currentCartSize > parseInt(prevCartSize)) {
                setTimeout(window.animateCartBadge, 300);
            }
            sessionStorage.setItem('bayim_cart_size', currentCartSize);
        });
    </script>

    <main class="container">